{
  // 攻略データの公開面。`kouryaku/publish.cljs` が生成した `site/` を
  // Workers static assets でそのまま配る（動的な処理は無いので worker script も
  // 持たない ―― assets だけの deploy）。
  //
  // ゾーンは itonami.cloud。**所有 org が cloud-itonami なのに配信が
  // etzhayyim.com / gftd.ai に乗っている**という食い違いを作らないため
  // （オーナー指示 2026-08-09）。custom_domain の形は cloud-itonami-app の
  // hooks.itonami.cloud / mcp.itonami.cloud に揃えてある。
  //
  // 同じ repo の `../wrangler.jsonc`（A→B link medium）は
  // media.itonami.cloud を取るので、こちらは kouryaku を名乗る。
  //
  // deploy:
  //   npm run kouryaku:publish            # site/ を生成
  //   npx wrangler deploy -c kouryaku/wrangler.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itonami-media-kouryaku",
  "compatibility_date": "2026-08-09",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./site",
    // ディレクトリ URL を index.html に解決し、未知のパスは 404 を返す
    // （SPA ではないので single-page fallback にしない ―― 存在しない攻略ページを
    //   200 で返すと、収集範囲外と壊れたリンクの区別がつかなくなる）。
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "kouryaku.itonami.cloud", "custom_domain": true }
  ]
}
